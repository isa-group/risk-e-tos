@prefix : <http://example.com/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix tosl: <https://w3id.org/tosl/> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix string: <http://www.w3.org/2000/10/swap/string#> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix risk: <https://w3id.org/dpv/risk#> .
@prefix justifications: <https://w3id.org/dpv/justifications#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tosl-risk: <https://w3id.org/tosl/risk#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .

{
    ?agreement :policyGraph ?G .

    ?G log:includes {
        ?perm a odrl:Permission ;
        odrl:assignee ?p ;
        odrl:action tosl:terminate ;
        odrl:target ?a .

        ?p a dpv-odrl:ServiceProvider .
    } .

    ?G log:notIncludes {
        ?perm odrl:constraint [
            odrl:leftOperand dpv-odrl:Justification
        ] .
    
        ?perm odrl:duty [
            odrl:action odrl:inform
        ] .

        ?perm odrl:constraint [
            odrl:leftOperand odrl:delayPeriod
        ] .
    } .

    ?G log:notIncludes {
        ?perm odrl:duty [
        odrl:action odrl:compensate
        ] .
    } .

    ( "Risk: agreement or services termination is permitted without restrictions (no justification constraint, no prior notice constraint, no duty to inform, and non-compensation). Permission: %s"
        ?perm ) string:format ?why .

    ( ?agreement :UnfairContractClause ?perm ) log:skolem ?src .
    ( ?agreement :RiskDataDeletion ?perm ) log:skolem ?risk .

}
=>
{

    ?perm a dpv:Permission .

    ?risk a dpv:Risk ;
        skos:broader risk:DataUnavailable, risk:ServiceTermination ;
        dct:description ?why ;
        dpv:hasRiskSource [
            a tosl-risk:UnilateralTerminationClause ;
            dpv:hasContractualClause ?perm
        ] ;
        dpv:isMitigatedByMeasure tosl-risk:TerminationNotice, tosl-risk:ProvideJustification, tosl-risk:RightToCompensation ;
        dpv:hasConsequence [
            a risk:DataLoss, risk:ServiceNotProvided ;
            dpv:hasImpact risk:FinancialLoss, risk:NonMaterialDamage, risk:CustomerConfidenceLoss ;
        ] .

    tosl-risk:TerminationNotice 
        :suggestAdd {
            ?perm 
            odrl:constraint [
                a odrl:Constraint ;
                odrl:leftOperand odrl:delayPeriod ;
                odrl:operator odrl:gteq ;
                odrl:rightOperand "P30D"^^xsd:duration
            ] ;
            odrl:duty [
                a odrl:Duty ;
                odrl:assignee :provider ;
                odrl:action odrl:inform ;
                odrl:informedParty :customer ;
                odrl:constraint [
                    a odrl:Constraint ;
                    odrl:leftOperand dpv-odrl:Purpose ;
                    odrl:operator odrl:isA ;
                    odrl:rightOperand dpv:CommunicationForCustomerCare 
                ] ;
                odrl:constraint [
                    a odrl:Constraint ;
                    odrl:leftOperand odrl:deliveryChannel ;
                    odrl:operator odrl:isA ;
                    odrl:rightOperand :customerContact
                ];
            ] .
            :customerContact a pd:Contact .
        } .

    tosl-risk:ProvideJustification
        :suggestAdd {
            ?perm 
            odrl:constraint [
                a odrl:Constraint ;
                odrl:leftOperand dpv-odrl:Justification ; 
                odrl:operator odrl:isAnyOf ;
                odrl:rightOperand (
                    justifications:SecurityImpaired
                    justifications:UnlawfulActivityObjection
                    justifications:LegalObligation
                )
            ] .
        } .

    tosl-risk:RightToCompensation
    :suggestAdd {
        ?perm 
        odrl:duty [
            a odrl:Duty ;
            odrl:assignee :provider ;
            odrl:action odrl:compensate ;
            odrl:informedParty :customer ;
            odrl:refinement [
                a odrl:Constraint ;
                odrl:leftOperand odrl:payAmount;
                odrl:operator odrl:eq;
                odrl:rightOperand "3000"^^xsd:decimal;
                odrl:unit <http://dbpedia.org/resource/Euro>
            ]
        ] .
    } .
} .